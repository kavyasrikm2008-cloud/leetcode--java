class Solution {
    public int maxSubArray(int[] nums) {
        
    int wSum = 0;
    int mSum = Integer.MIN_VALUE;
    for(int i=0;i<nums.length;i++)
      {
        wSum += nums[i];
        mSum = Math.max(wSum,mSum);

        if(wSum<0)
        {
            wSum = 0;
        }
      }
      return mSum;
    } 
}
