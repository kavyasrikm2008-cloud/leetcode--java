class Solution {
    public String toHex(int num) {
       if(num == 0)
       return "0";

       char[] hex = "012345689abcdef".toCharArray();
       StringBuilder result = new StringBuilder();
       while(num != 0)
       {
        int rem = num & 15;//get last digit
        result.append(hex[rem]);
        num = num>>>4;//hex represents four binary bits
       }
       return result.reverse().toString();
    }
}
