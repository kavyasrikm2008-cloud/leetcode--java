class Solution {
    public boolean isHappy(int n) {
        int count = 0;
        while(n!=1)
        {
            int sum = 0;
            while(n>0)
            {
                int digit = n%10;
                sum = sum+digit*digit;
                n = n/10;
            }
            n = sum;
            count++;
            if(count>20)
            return false;
        }
        return true;
    }
}
